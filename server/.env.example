# Copy to .env for local development.
# On Render, set these in the service dashboard instead.

# Comma-separated mail domains the server accepts (MX for each must point
# to the host running the public SMTP receiver).
ALLOWED_DOMAINS=temp.realblue.lol,od3n.online,od3n.info

# HTTP API port. Render injects PORT automatically; locally defaults to 3001.
PORT=3001

# SMTP receiver port. Defaults to 2525. Use 25 on a VPS (requires root).
SMTP_PORT=2525

# SQLite connection string. On Render use a persistent disk path, e.g.
#   DATABASE_URL=sqlite:/var/data/tempmail.db?mode=rwc
DATABASE_URL=sqlite:tempmail.db?mode=rwc

# Hostname advertised in SMTP 220/EHLO responses.
SMTP_HOSTNAME=localhost

# Lifetime of generated temp addresses, in minutes.
EMAIL_TTL_MINUTES=10
