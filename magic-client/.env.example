# Copy to .env.local for development, and set the same keys in Vercel for production.

# Server-side: upstream backend for next.config.ts rewrites (dev proxy).
BACKEND_URL=http://127.0.0.1:3001

# Public: direct browser base URL for REST + SSE. Unset = use rewrites (local dev).
# In production set to your Render HTTPS URL, e.g. https://magic-mail.onrender.com
# NEXT_PUBLIC_API_URL=
